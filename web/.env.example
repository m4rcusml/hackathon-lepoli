# Base fixa da API temporária. Sem configuração, o modo real retorna erro explícito.
# Exemplo: http://localhost:4000/api/doctor/v0/
DOCTOR_API_UPSTREAM_URL=
# Origem pública exata da web quando há proxy de implantação (sem barra final).
DOCTOR_WEB_ORIGIN=
# Origens exatas dos redirects controlados de login (separadas por vírgula).
DOCTOR_AUTH_REDIRECT_ORIGINS=
# Demo habilitada por padrão só em desenvolvimento. Para build/E2E local:
DOCTOR_DEMO_ENABLED=false
